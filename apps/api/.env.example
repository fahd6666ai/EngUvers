# apps/api local dev — used only when running `pnpm --filter @enguvers/api dev`
# outside docker-compose. Inside docker-compose these are injected by the
# root .env instead.
DATABASE_URL=postgresql://enguvers:enguvers_dev_password@localhost:5432/enguvers
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Phase 1 — deferred inputs (see CLAUDE.md phase log):
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: not set yet, Google sign-in stays
# disabled in the UI until real OAuth credentials are provided.
# Phone OTP uses a dev-mode provider that logs the code to the API console
# instead of sending an SMS — no env var needed until a real SMS gateway
# is chosen.
