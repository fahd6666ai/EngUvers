// EngUvers — Phase 0/1 schema. See docs/ERD.md for the diagram this
// mirrors. Later phases (courses, exams, projects, circuit-lab saves,
// etc.) add their own models here, referencing User/Entitlement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  engineer
  instructor
  company
  university
  admin
}

enum Locale {
  ar
  en
}

enum PlanCode {
  free
  student_pro
  engineer_pro
  university
  enterprise
}

enum EntitlementSource {
  subscription
  voucher
  admin_grant
}

enum EntitlementStatus {
  active
  expired
  revoked
}

enum VoucherStatus {
  unused
  activated
  revoked
}

enum PaymentProvider {
  voucher
  stripe
  regional_gateway
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum LessonContentType {
  video
  article
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  oauthProvider String?
  role          Role      @default(student)
  locale        Locale    @default(ar)
  countryId     String?
  country       Country?  @relation(fields: [countryId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile      Profile?
  skills       UserSkill[]
  badges       UserBadge[]
  entitlements Entitlement[]
  transactions PaymentTransaction[]
  activatedVouchers Voucher[] @relation("VoucherActivatedBy")
  auditLogs    AuditLog[]
  circuitProjects CircuitProject[]
  coursesAuthored   Course[]           @relation("CourseAuthor")
  courseEnrollments CourseEnrollment[]
  lessonCompletions LessonCompletion[]
  booksAdded        Book[]             @relation("BookAddedBy")

  @@map("users")
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String?
  avatarUrl    String?
  bio          String?
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  majorId      String?
  major        Major?   @relation(fields: [majorId], references: [id])
  studyYear    Int?
  updatedAt    DateTime @updatedAt

  @@map("profiles")
}

model Country {
  id     String @id @default(cuid())
  code   String @unique
  nameAr String
  nameEn String

  universities University[]
  users        User[]

  @@map("countries")
}

model University {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  nameAr    String
  nameEn    String

  faculties Faculty[]
  profiles  Profile[]

  @@unique([countryId, nameEn])
  @@map("universities")
}

model Faculty {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  nameAr       String
  nameEn       String

  majors Major[]

  @@unique([universityId, nameEn])
  @@map("faculties")
}

model Major {
  id        String   @id @default(cuid())
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  // Globally unique for now: every seeded major in Phase 1 is generic
  // (facultyId null, the brief §1 discipline list). A university-specific
  // major catalog, if ever needed, would need a different uniqueness
  // scope than this.
  nameEn        String @unique
  nameAr        String
  disciplineTag String

  curricula Curriculum[]
  profiles  Profile[]

  @@map("majors")
}

model Subject {
  id            String  @id @default(cuid())
  nameAr        String
  nameEn        String
  disciplineTag String

  curricula Curriculum[]

  @@map("subjects")
}

model Curriculum {
  id        String  @id @default(cuid())
  majorId   String
  major     Major   @relation(fields: [majorId], references: [id])
  studyYear Int
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([majorId, studyYear, subjectId])
  @@map("curricula")
}

model Plan {
  id         String   @id @default(cuid())
  code       PlanCode @unique
  nameAr     String
  nameEn     String
  priceModel Json

  entitlements  Entitlement[]
  voucherBatches VoucherBatch[]
  limits        PlanLimit[]

  @@map("plans")
}

model PlanLimit {
  id         String @id @default(cuid())
  planId     String
  plan       Plan   @relation(fields: [planId], references: [id])
  feature    String
  dailyQuota Int?

  @@unique([planId, feature])
  @@map("plan_limits")
}

model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  planId    String
  plan      Plan              @relation(fields: [planId], references: [id])
  source    EntitlementSource
  status    EntitlementStatus @default(active)
  startsAt  DateTime          @default(now())
  endsAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, status])
  @@map("entitlements")
}

model VoucherBatch {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])
  quantity  Int
  createdBy String
  createdAt DateTime @default(now())

  vouchers Voucher[]

  @@map("voucher_batches")
}

model Voucher {
  id               String        @id @default(cuid())
  batchId          String
  batch            VoucherBatch  @relation(fields: [batchId], references: [id])
  codeHash         String        @unique
  status           VoucherStatus @default(unused)
  activatedByUserId String?
  activatedByUser  User?         @relation("VoucherActivatedBy", fields: [activatedByUserId], references: [id])
  activatedAt      DateTime?
  createdAt        DateTime      @default(now())

  @@map("vouchers")
}

model PaymentTransaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  provider    PaymentProvider
  amount      Decimal
  currency    String
  status      PaymentStatus   @default(pending)
  externalRef String?
  createdAt   DateTime        @default(now())

  @@map("payment_transactions")
}

model Skill {
  id            String @id @default(cuid())
  nameAr        String
  nameEn        String
  disciplineTag String

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  points    Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Badge {
  id       String @id @default(cuid())
  code     String @unique
  nameAr   String
  nameEn   String
  criteria Json

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// Phase 1 — phone OTP verification codes. Dev-mode provider logs the code
// instead of sending an SMS (see src/auth/otp/console-otp.provider.ts);
// swap the provider when a real SMS gateway is chosen, this table doesn't
// change.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("phone_otps")
}

// Phase 2 — Circuit Lab (Velxio). One row per saved circuit workspace;
// `vlxContent` is the whole .vlx JSON payload (see
// services/simulator/bridge-overlay/frontend's PROJECT_CHANGED/PROJECT_DATA
// messages) — the same format Velxio's own .vlx export/import uses, so a
// project round-trips as a file too. `version` is a plain optimistic
// counter bumped on every autosave, not a version-history table (Phase 2
// scope doesn't need one).
model CircuitProject {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  vlxContent   Json
  thumbnailUrl String?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
  @@map("circuit_projects")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

// Phase 3 — Engineering Academy (EA). A Course is authored by an
// instructor/admin (content-admin routes, role-gated) and, once
// `published`, is enrollable by anyone with the `academy.courses`
// entitlement (granted to the `free` plan in prisma/seed.ts — this
// feature has no missing external dependency the way ise.analysis does,
// so it isn't gated behind a placeholder). `CourseEnrollment.completedAt`
// is set once every one of the course's lessons has a matching
// `LessonCompletion` row for that user — see AcademyService.
model Course {
  id            String      @id @default(cuid())
  titleAr       String
  titleEn       String
  summaryAr     String
  summaryEn     String
  disciplineTag String
  level         CourseLevel @default(beginner)
  published     Boolean     @default(false)
  authorId      String
  author        User        @relation("CourseAuthor", fields: [authorId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lessons     Lesson[]
  enrollments CourseEnrollment[]

  @@index([published, disciplineTag])
  @@map("courses")
}

model Lesson {
  id              String            @id @default(cuid())
  courseId        String
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  titleAr         String
  titleEn         String
  contentType     LessonContentType @default(article)
  videoUrl        String?
  bodyAr          String?
  bodyEn          String?
  order           Int
  durationMinutes Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  completions LessonCompletion[]

  @@unique([courseId, order])
  @@map("lessons")
}

model CourseEnrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@map("lesson_completions")
}

// Phase 3 — Engineering Books (EB). Simpler than Course: a flat catalog,
// no lessons/enrollment. `fileUrl` is deliberately never returned by the
// public catalog/detail endpoints — only by the entitlement-gated
// `GET /library/books/:id/access` (same "hide the resource behind a
// dedicated gated endpoint, not a field filter" shape as
// CircuitLabService.issueSessionToken) — see LibraryService.
model Book {
  id            String   @id @default(cuid())
  titleAr       String
  titleEn       String
  authorName    String
  descriptionAr String
  descriptionEn String
  disciplineTag String
  coverImageUrl String?
  fileUrl       String
  published     Boolean  @default(false)
  addedById     String
  addedBy       User     @relation("BookAddedBy", fields: [addedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, disciplineTag])
  @@map("books")
}
