# Dev-only image: installs the whole workspace, runs Next.js in dev mode.
# Source is bind-mounted by docker-compose for hot reload; the COPY here
# only seeds the image so `docker compose up --build` works standalone too.
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile=false

WORKDIR /repo/apps/web
EXPOSE 3000
CMD ["pnpm", "dev"]
