# services/ai local dev — used when running uvicorn directly, outside
# docker-compose (which injects these from the root .env instead).

# Same secret as apps/api's JWT_SECRET — this service verifies the same
# tokens apps/api issues; it has no auth system of its own.
JWT_SECRET=change-me-in-production

AI_PORT=4100

# Deferred (see CLAUDE.md's Phase Log): until both are set, every
# LLM-backed route answers 503 via UnavailableLLMProvider instead of
# fabricating a response. ANTHROPIC_MODEL has no default — this service
# never hardcodes a model name.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
