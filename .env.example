# EngUvers — root environment template.
# Copy to `.env` for docker-compose. Per-app dev servers read
# apps/web/.env.local and apps/api/.env (also templated below) when run
# outside Docker.

# ---- Postgres ----
POSTGRES_USER=enguvers
POSTGRES_PASSWORD=enguvers_dev_password
POSTGRES_DB=enguvers
DATABASE_URL=postgresql://enguvers:enguvers_dev_password@postgres:5432/enguvers

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=enguvers
MINIO_ROOT_PASSWORD=enguvers_dev_password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=enguvers-dev

# ---- Meilisearch ----
MEILI_MASTER_KEY=enguvers_dev_master_key
MEILI_URL=http://meilisearch:7700

# ---- apps/api ----
API_PORT=4000
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000

# ---- apps/web ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- services/ai (Phase 4 — not used yet) ----
# ANTHROPIC_API_KEY=

# ---- services/simulator (Phase 2 — not used yet) ----
# SIMULATOR_BASE_URL=
